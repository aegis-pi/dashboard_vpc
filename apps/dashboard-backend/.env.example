# Dashboard Backend environment variables
# Copy to .env for local development — .env is git-ignored

DATABASE_URL=postgresql+asyncpg://aegis:changeme@localhost:5432/aegis_dashboard
DATABASE_AUTO_CREATE_METADATA=true
REDIS_URL=redis://localhost:6379
REDIS_AUTH_TOKEN_SECRET_ARN=
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_PUBSUB_OPERATION_TIMEOUT_SECONDS=6

DDB_TABLE_STATUS=AEGIS-DynamoDB-FactoryStatus
DDB_TABLE_REPORT=aegis-daily-report
DASHBOARD_FACTORY_IDS=factory-a,factory-b,factory-c
# scan_latest discovers LATEST factory rows automatically.
# configured uses only DASHBOARD_FACTORY_IDS via BatchGetItem.
DASHBOARD_FACTORY_DISCOVERY_MODE=scan_latest
DASHBOARD_FACTORY_SCAN_LIMIT=200
DDB_CONNECT_TIMEOUT_SECONDS=2
DDB_READ_TIMEOUT_SECONDS=5
DDB_OPERATION_TIMEOUT_SECONDS=12
DDB_MAX_ATTEMPTS=2
DDB_MAX_POOL_CONNECTIONS=20
DDB_MAX_CONCURRENT_OPERATIONS=10

S3_BUCKET_DATA=aegis-bucket-data
S3_CONNECT_TIMEOUT_SECONDS=2
S3_READ_TIMEOUT_SECONDS=5
S3_OPERATION_TIMEOUT_SECONDS=12
S3_MAX_ATTEMPTS=2
S3_MAX_POOL_CONNECTIONS=10

COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_JWKS_TIMEOUT_SECONDS=5
COGNITO_JWKS_TTL_SECONDS=3600
RBAC_BOOTSTRAP_SUPER_ADMIN_SUBS=

AWS_REGION=ap-south-1

# Bedrock chatbot
# Default local code path now uses Amazon Nova (ADR 0035).
BEDROCK_ENABLED=true
BEDROCK_REGION=ap-south-1
CHAT_ROUTING_ENABLED=true
BEDROCK_RESOLVE_MODEL=apac.amazon.nova-micro-v1:0
BEDROCK_MODEL_FAST=apac.amazon.nova-pro-v1:0
BEDROCK_MODEL_PRECISE=apac.amazon.nova-pro-v1:0
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0.2
BEDROCK_CONNECT_TIMEOUT_SECONDS=3
BEDROCK_READ_TIMEOUT_SECONDS=20
BEDROCK_OPERATION_TIMEOUT_SECONDS=25
BEDROCK_MAX_ATTEMPTS=2
BEDROCK_RESOLVE_MAX_TOKENS=512
BEDROCK_RESOLVE_OPERATION_TIMEOUT_SECONDS=12
